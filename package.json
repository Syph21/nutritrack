{
  "name": "nutritrack-offline",
  "version": "1.0.0",
  "description": "NutriTrack Offline - a single-file, offline-first calorie & macro tracker.",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npx serve . -l 5173",
    "dev": "npx serve . -l 5173",
    "build:web": "node scripts/build-web.js",
    "cap:sync": "npm run build:web && npx cap sync",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android",
    "cap:add:ios": "npx cap add ios",
    "cap:add:android": "npx cap add android",
    "lint": "node scripts/check.js"
  },
  "dependencies": {
    "@capacitor/core": "^6.0.0",
    "@capacitor/ios": "^6.0.0",
    "@capacitor/android": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "serve": "^14.2.0"
  }
}
